rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Public profile document (never contains sensitive fields like email)
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow write: if isOwner(userId);

      // Private PII subcollection (e.g. email, phone) - strictly owner only
      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Username mapping index for fast lookups & uniqueness
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn() 
        && incoming().uid == request.auth.uid 
        && (!exists(/databases/$(database)/documents/usernames/$(username)) || existing().uid == request.auth.uid);
      allow update, delete: if isSignedIn() && existing().uid == request.auth.uid;
    }

    // Messages validation helper
    function isValidMessageData(data) {
      return data.recipientId is string 
        && data.recipientId.size() > 0 
        && data.recipientId.size() <= 128
        && data.text is string 
        && data.text.trim().size() > 0 
        && data.text.size() <= 500
        && data.isRead == false
        && data.isFavorite == false
        && data.isFlagged == false
        && data.keys().hasAll(['recipientId', 'text', 'isRead', 'isFavorite', 'isFlagged'])
        && data.keys().hasOnly(['recipientId', 'recipientUsername', 'text', 'promptQuestion', 'isRead', 'isFavorite', 'isFlagged', 'createdAt']);
    }

    // Messages collection
    match /messages/{messageId} {
      allow create: if isValidMessageData(incoming());
      allow read, update, delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    // Reports validation helper
    function isValidReportData(data) {
      return data.messageId is string && data.messageId.size() > 0
        && data.recipientId is string && data.recipientId.size() > 0
        && data.reason is string && data.reason.size() <= 500
        && data.keys().hasAll(['messageId', 'recipientId', 'reason']);
    }

    // Reports collection
    match /reports/{reportId} {
      allow create: if isValidReportData(incoming());
      // Read & delete reserved for admin
      allow read, delete: if false;
    }
  }
}
